<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Orka" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/orka_splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Orka.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/orka_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/orka_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Orka</item>
    </style>
</resources>
